# Ausschließlich eine separate, wertlose Testnet-Wallet verwenden.
# Hier steht nur ihre öffentliche Adresse; der private Schlüssel bleibt im Keystore.
TESTNET_DEPLOYER_ADDRESS=0x0000000000000000000000000000000000000000

# Absoluter Pfad außerhalb des Repositorys; der automatische Windows-Bootstrap
# verwendet %LOCALAPPDATA%\REIST\base-sepolia-wallets.
REIST_KEYSTORE_DIRECTORY=C:\ABSOLUTER\PFAD\ZU\base-sepolia-wallets

BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Drei Empfängeradressen; alle drei und die Deployment-Wallet müssen verschieden sein.
# Für einen realistischen Test sollten die Treasury-Adressen separate Base-Sepolia-Safes sein.
FOUNDER_BENEFICIARY=0x0000000000000000000000000000000000000000
RESEARCH_REWARDS_TREASURY=0x0000000000000000000000000000000000000000
ECOSYSTEM_TREASURY=0x0000000000000000000000000000000000000000

# Nur für `npm run verify:testnet`; niemals in Repository oder Manifest übernehmen.
ETHERSCAN_API_KEY=

# Kanonische Paper-Version des REIST-Token-Piloten.
REIST_PAPER_DOI=10.5281/zenodo.21206471
